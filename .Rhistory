filter(year %in% c(past_year, latest_year)) %>%
select(country, year, lifeExp) %>%
pivot_wider(names_from = year, values_from = lifeExp) %>%
mutate(growth = !!sym(as.character(latest_year)) -
!!sym(as.character(past_year))) %>%
arrange(desc(growth)) %>%
slice_head(n = 5)
