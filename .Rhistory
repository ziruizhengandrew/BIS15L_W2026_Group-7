menuItem("Season Analysis", tabName = "season"),
menuItem("Sex Analysis", tabName = "sex"),
menuItem("Site Analysis", tabName = "site"),
menuItem("Morphological Scaling", tabName = "scaling"),
menuItem("Capture Map", tabName = "map")
)
),
dashboardBody(
skin="lightblue",
tabItems(
# -------- SEASON TAB --------
tabItem(tabName = "season",
fluidRow(
box(width = 4,
selectInput("season_y",
"Variable",
choices = c("Forearm Length"="forearm",
"Ear Length"="ear",
"Mass"="mass"))
),
box(width = 8,
plotOutput("season_plot"),
verbatimTextOutput("season_text")
)
)
),
# -------- SEX TAB --------
tabItem(tabName = "sex",
fluidRow(
box(width = 4,
selectInput("sex_y",
"Variable",
choices = c("Forearm Length"="forearm",
"Ear Length"="ear",
"Mass"="mass"))
),
box(width = 8,
plotOutput("sex_plot"),
verbatimTextOutput("sex_text")
)
)
),
# -------- SITE TAB --------
tabItem(tabName = "site",
fluidRow(
box(width = 4,
selectInput("site_y",
"Variable",
choices = c("Forearm Length"="forearm",
"Ear Length"="ear",
"Mass"="mass"))
),
box(width = 8,
plotOutput("site_plot"),
verbatimTextOutput("site_text")
)
)
),
# -------- SCALING TAB --------
tabItem(tabName = "scaling",
fluidRow(
box(width = 4,
selectInput("x_var",
"Body Measurement",
choices = c("Forearm Length" = "forearm",
"Ear Length" = "ear"))
),
box(width = 8,
plotOutput("scaling_plot"),
verbatimTextOutput("scaling_text")
)
)
),
# -------- LEAFLET MAP TAB --------
tabItem(tabName = "map",
fluidRow(
box(width = 12,
leafletOutput("capture_map", height = 600)
)
)
)
)
))
server <- function(input, output) {
# -------- SEASON PLOT --------
output$season_plot <- renderPlot({
ggplot(capture,
aes(x = season,
y = .data[[input$season_y]],
fill = season)) +
geom_boxplot() +
scale_fill_manual(values = project_palette) +
theme_minimal()
})
output$season_text <- renderPrint({
capture %>%
group_by(season) %>%
summarise(mean_value =
mean(.data[[input$season_y]], na.rm=TRUE))
})
# -------- SEX PLOT --------
output$sex_plot <- renderPlot({
ggplot(capture,
aes(x = sex,
y = .data[[input$sex_y]],
fill = sex)) +
geom_boxplot() +
scale_fill_manual(values = project_palette) +
theme_minimal()
})
output$sex_text <- renderPrint({
capture %>%
group_by(sex) %>%
summarise(mean_value =
mean(.data[[input$sex_y]], na.rm=TRUE))
})
# -------- SITE PLOT --------
output$site_plot <- renderPlot({
ggplot(capture,
aes(x = site,
y = .data[[input$site_y]],
fill = site)) +
geom_boxplot() +
scale_fill_manual(values = project_palette) +
theme_minimal() +
theme(axis.text.x =
element_text(angle = 45, hjust = 1))
})
# -------- SCALING PLOT --------
output$scaling_plot <- renderPlot({
ggplot(capture,
aes(x = .data[[input$x_var]],
y = .data[[input$y_var]])) +
geom_point(color = project_palette[4], alpha = 0.7) +
geom_smooth(method="lm", color="black") +
theme_minimal()
})
output$scaling_text <- renderPrint({
model <- lm(capture[[input$y_var]] ~ capture[[input$x_var]])
summary(model)
})
# -------- LEAFLET MAP --------
output$capture_map <- renderLeaflet({
leaflet(data = capture) %>%
addProviderTiles("CartoDB.Positron") %>%
addCircleMarkers(
lng = ~lon,
lat = ~lat,
radius = 6,
color = project_palette[3],
stroke = FALSE,
fillOpacity = 0.8,
popup = paste(
"<b>Site:</b>", site,
"<br><b>Season:</b>", season,
"<br><b>Mass:</b>", mass
)
)
})
}
shinyApp(ui, server)
